# Copy to .env for docker compose (never commit secrets).
POSTGRES_USER=noema
POSTGRES_PASSWORD=noema
POSTGRES_DB=noema
POSTGRES_PORT=5432

NOEMA_PORT=8080
NOEMA_ENV=local
# Optional development/operator gate for /admin. Never expose or commit the value.
# NOEMA_ADMIN_TOKEN=replace-with-an-operator-secret
# DSN used by the noema service container (host is the compose service name).
NOEMA_DB=postgresql://noema:noema@postgres:5432/noema

# Optional: host-side tests against compose Postgres
# NOEMA_TEST_PG_DSN=postgresql://noema:noema@127.0.0.1:5432/noema

# --- Hosted product (Supabase-backed) ---
# Point NOEMA_DB at Supabase Postgres (session/direct connection preferred for writer).
# NOEMA_DB=postgresql://postgres.<ref>:<password>@aws-0-....pooler.supabase.com:5432/postgres
#
# Supabase Auth (human login). Local agent tests work without these via /auth/human dev_subject.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_JWT_SECRET=your-jwt-secret-from-project-settings
#
# Signs Noema controller access/refresh tokens (agents). Distinct from Supabase JWT secret.
# TOKEN_SIGNING_SECRET=generate-a-long-random-string
# AUTH_SECRET=generate-a-long-random-string
