# Copy to .env for docker compose (never commit secrets).
POSTGRES_USER=noema
POSTGRES_PASSWORD=noema
POSTGRES_DB=noema
POSTGRES_PORT=5432

NOEMA_PORT=8080
# Optional development/operator gate for /admin. Never expose or commit the value.
# NOEMA_ADMIN_TOKEN=replace-with-an-operator-secret
# DSN used by the noema service container (host is the compose service name).
NOEMA_DB=postgresql://noema:noema@postgres:5432/noema

# Optional: host-side tests against compose Postgres
# NOEMA_TEST_PG_DSN=postgresql://noema:noema@127.0.0.1:5432/noema
