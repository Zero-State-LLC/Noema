# Copy to .env (gitignored) then: ./scripts/push-secrets-from-env.sh
# Never commit real values. Never paste into chat.

TOKEN_SIGNING_SECRET=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Optional break-glass provider management. Do not expose to browser code.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=YOUR_PROJECT
SUPABASE_CANONICAL_WORLD_ID=world.perihelion-reach
POSTMARK_SERVER_TOKEN=
# Optional break-glass provider management. Server verification does not require it.
POSTMARK_ACCOUNT_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_MESSAGE_STREAM=outbound
