{
  "name": "noema-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Noema Stage 0 Cloudflare Worker + World Durable Object",
  "scripts": {
    "dev": "wrangler dev --var NOEMA_ENV:local",
    "deploy": "bash ./scripts/deploy-stage0.sh",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit",
    "build:map-gl": "node ./scripts/build-watch-map-gl.mjs",
    "test": "npm run build:map-gl && vitest run",
    "smoke": "node ./scripts/smoke.mjs",
    "smoke:hosted": "node ./scripts/hosted-conformance.mjs",
    "rehearse:rollback": "node ./scripts/rollback-rehearsal.mjs",
    "secrets:push": "bash ./scripts/push-secrets-from-env.sh",
    "secrets:list": "wrangler secret list"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "three": "^0.186.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
