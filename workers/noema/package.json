{
  "name": "noema-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Noema Stage 0 Cloudflare Worker + World Durable Object",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "bash ./scripts/deploy-stage0.sh",
    "deploy:raw": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node ./scripts/smoke.mjs",
    "secrets:push": "bash ./scripts/push-secrets-from-env.sh",
    "secrets:list": "wrangler secret list"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250812.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
