{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noema-rollback-rehearsal-template",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "version_metadata": {
    "binding": "CF_VERSION"
  },
  "vars": {
    "NOEMA_ENV": "test",
    "NOEMA_PROTOCOL_VERSION": "1",
    "DEFAULT_WORLD_ID": "test.hosted-canonical.ewm-cutover",
    "ROLLBACK_REHEARSAL_PHASE": "template"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORLD_DO",
        "class_name": "NoemaWorldDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NoemaWorldDO"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true
    }
  }
}
