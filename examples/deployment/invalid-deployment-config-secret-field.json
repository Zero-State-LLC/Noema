{
  "schema_version": "deployment-config/1.0",
  "env": "local",
  "app_url": "http://localhost:3000",
  "database": {
    "engine": "postgresql"
  },
  "object_storage": {
    "adapter": "filesystem"
  },
  "world": {
    "world_id": "world-01",
    "max_agents": 10
  },
  "replay": {
    "deterministic_mode": true
  },
  "security": {
    "sandbox_mode": "strict",
    "outbound_network_policy": "deny-by-default"
  },
  "architecture": {
    "shape": "modular-monolith"
  },
  "auth_secret": "must-not-appear-in-resolved-config"
}
